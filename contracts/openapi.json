{
  "openapi": "3.1.0",
  "info": {
    "title": "Blancco application workflow API",
    "version": "1.0.0",
    "description": "Local implementation, requires deployment and device verification."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8089"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/v1/request-key": {
      "post": {
        "operationId": "requestKey",
        "summary": "Get one idempotency key before starting a workflow",
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestKey"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/lookup": {
      "get": {
        "operationId": "lookup",
        "parameters": [
          {
            "name": "serial",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lookup"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/attempts/start": {
      "post": {
        "operationId": "startAttempt",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            }
          },
          "201": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": " BAR compatibility: POST with an empty body and query parameters is also supported. Do not combine query parameters with a JSON body. Authorization remains in the header. BAR URL-parameter mode returns 200 for a newly created attempt because this client routes 201 through its failure output. JSON body mode retains 201.",
        "parameters": [
          {
            "name": "serial",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alternative to the JSON request body; do not mix both transports."
          },
          {
            "name": "jobId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alternative to the JSON request body; do not mix both transports."
          },
          {
            "name": "configurationVersion",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alternative to the JSON request body; do not mix both transports."
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alternative to the JSON request body; do not mix both transports."
          },
          {
            "name": "requestKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alternative to the JSON request body; do not mix both transports."
          },
          {
            "name": "retryConfirmed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Alternative to the JSON request body; do not mix both transports."
          }
        ]
      }
    },
    "/v1/attempts/{attemptId}/complete": {
      "post": {
        "operationId": "completeAttempt",
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Empty body required. Identical delivery returns original completion time.",
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Completion"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/attempts/{attemptId}/fail": {
      "post": {
        "operationId": "failAttempt",
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "failureCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alternative to the JSON request body; do not mix both transports."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "failureCode"
                ],
                "properties": {
                  "failureCode": {
                    "type": "string",
                    "pattern": "^[A-Z0-9_]{1,100}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Completion"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": " BAR compatibility: POST with an empty body and query parameters is also supported. Do not combine query parameters with a JSON body. Authorization remains in the header."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RequestKey": {
        "type": "object",
        "required": [
          "requestKey"
        ],
        "properties": {
          "requestKey": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Lookup": {
        "type": "object",
        "required": [
          "decision",
          "reasonCode",
          "message",
          "jobId",
          "imageName",
          "useDpk",
          "hasDpk"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "AUTO",
              "ASK_RETRY",
              "MANUAL",
              "WAIT",
              "BLOCKED",
              "BUSY"
            ]
          },
          "reasonCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "jobId": {
            "type": [
              "string",
              "null"
            ]
          },
          "configurationVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "orderNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "imageName": {
            "type": "string"
          },
          "useDpk": {
            "type": "boolean"
          },
          "hasDpk": {
            "enum": [
              "YES",
              "NO"
            ]
          },
          "installedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retryUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "StartRequest": {
        "type": "object",
        "required": [
          "serial",
          "mode",
          "requestKey"
        ],
        "properties": {
          "serial": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "mode": {
            "enum": [
              "order",
              "manual"
            ]
          },
          "requestKey": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{16,100}$"
          },
          "jobId": {
            "type": [
              "string",
              "null"
            ]
          },
          "configurationVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryConfirmed": {
            "type": "boolean",
            "default": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "order"
                }
              }
            },
            "then": {
              "required": [
                "jobId",
                "configurationVersion"
              ],
              "properties": {
                "jobId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "configurationVersion": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "Attempt": {
        "type": "object",
        "required": [
          "attemptId",
          "state",
          "mode",
          "imageName",
          "useDpk",
          "hasDpk",
          "finishedAt"
        ],
        "properties": {
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "started",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "mode": {
            "enum": [
              "manual",
              "order"
            ]
          },
          "imageName": {
            "type": "string"
          },
          "useDpk": {
            "type": "boolean"
          },
          "hasDpk": {
            "enum": [
              "YES",
              "NO"
            ]
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Completion": {
        "type": "object",
        "required": [
          "attemptId",
          "state",
          "finishedAt"
        ],
        "properties": {
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
